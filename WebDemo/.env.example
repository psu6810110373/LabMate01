# Supabase Connection Configuration
# Copy this file to .env.local and replace with your Supabase Project details
VITE_SUPABASE_URL=https://your-supabase-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Bitstream MQTT Broker Configuration
VITE_BITSTREAM_MQTT_URL=ws://127.0.0.1:8883/mqtt
VITE_BITSTREAM_MQTT_TOPIC=
VITE_SHT40_MQTT_TOPIC=SHT40


